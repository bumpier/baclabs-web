# Copy to .env.local and fill in real values. NEVER commit .env.local.
#
# Prisma's CLI reads .env (not .env.local), so DATABASE_URL needs to be in
# BOTH files. Everything else belongs in .env.local only.

# ── Database ──────────────────────────────────────────────────────
# Prisma resolves `file:` relative to prisma/, NOT the repo root, so this
# lands at <project-root>/data/baclab.db. Using file:./data/... silently
# creates prisma/data/ and the migration never reaches the real database.
DATABASE_URL="file:../data/baclab.db"

# Public site URL. Used for canonical tags, Open Graph, the sitemap, Stripe
# success/cancel redirects and transactional email links. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://baclab.co.uk

# Origin of the WordPress site that now serves the guides and the blog.
# No trailing slash. Set it and this site stops serving /guides and /blog:
# both 301 to the same path on that origin, they leave sitemap.xml and
# llms.txt, and every internal link points straight at the new URL instead
# of through the redirect.
#
# RUNTIME, deliberately — not a build arg, not NEXT_PUBLIC_. The switch can
# be flipped with a restart rather than a rebuild, which is what lets the
# code ship before WordPress is live.
#
# DO NOT SET THIS UNTIL THE DESTINATION IS ACTUALLY SERVING THOSE PATHS.
# Turning it on early 301s thirteen ranking URLs to nothing.
BLOG_ORIGIN=https://blog.baclab.co.uk

# Google Search Console ownership token (the `content` value of the HTML-tag
# method). Optional; leave empty and no tag is rendered.
#
# BUILD-TIME, and it is a docker build arg: the home page is a static
# prerender, so the meta tag is baked in during `next build`. Setting this and
# restarting does nothing — the container must be REBUILT.
GOOGLE_SITE_VERIFICATION=

# Public contact address, shown on the contact page, in the footer, in the
# price-match guarantee, the wholesale answer and the Organization JSON-LD.
# Empty renders nothing anywhere and the pages reword themselves so they do
# not instruct contact that cannot be made.
#
# The domain must be able to RECEIVE mail before you set this — check that an
# MX record exists for it. Build-time (NEXT_PUBLIC_), so a rebuild is needed.
NEXT_PUBLIC_CONTACT_EMAIL=

# ── Card payments (Stripe) ────────────────────────────────────────
# STRIPE_ENABLED is the kill switch and must equal the literal "true".
# Set it to false and restart to stop taking card payments instantly;
# crypto keeps working. Flip the flag — never delete the keys, or the
# webhook cannot verify already-captured payments and they sit unfulfilled.
STRIPE_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# One Stripe Price per bundle tier. Generate them with:
#   npx tsx scripts/stripe-setup.ts --apply
# which prints these lines ready to paste. Run it once with a test key
# and once with a live key — the values differ between the two modes.
STRIPE_PRICE_SINGLE=
STRIPE_PRICE_FIVE=
STRIPE_PRICE_TEN=
STRIPE_PRICE_TWENTY=
STRIPE_PRICE_FIFTY=
STRIPE_PRICE_HUNDRED=

# Optional. A Stripe shipping rate id (shr_…) added to every Checkout Session.
# Leave blank and Stripe charges nothing for delivery.
STRIPE_SHIPPING_RATE_ID=

# ── Crypto payments (secondary) ───────────────────────────────────
# Defaults to ON when unset. Set to "false" to hide the crypto option.
# CRYPTO_ENABLED=true
# CRYPTO_GATEWAY_URL — base URL of the self-hosted gateway.
# CRYPTO_WEBHOOK_SECRET — MUST exactly equal the gateway's WEBHOOK_SECRET.
CRYPTO_GATEWAY_URL=
CRYPTO_WEBHOOK_SECRET=

# ── Analytics (both optional) ─────────────────────────────────────
# WARNING: both are inlined at BUILD time. Setting one later and only
# restarting does nothing — you must rebuild.
# Leave blank and no tracking script loads at all.
# Note: enabling either almost certainly requires a cookie-consent banner in
# the UK. None is built.
# ── Sale preview ──────────────────────────────────────────────────
# Renders the sale UI (struck-through prices, "30% off" badge and banner)
# WITHOUT a qualifying reference period, for design review only. Inlined at
# BUILD time. Leave unset everywhere customers can reach — a struck-through
# price must be one the product was genuinely sold at. See SALE in
# config/funnel.ts.
NEXT_PUBLIC_SALE_PREVIEW=

# ── Analytics ─────────────────────────────────────────────────────
# The Meta Pixel is normally set in the admin panel instead: Settings →
# Meta Pixel (/admin/settings). That value is read at RUNTIME, so it can be
# changed without a rebuild and survives a redeploy — which this build arg
# cannot, being inlined at build time. Leave this blank unless you want a
# pixel baked in before the admin panel is reachable; the admin value wins,
# and saving an empty value there switches tracking off regardless of this.
NEXT_PUBLIC_META_PIXEL_ID=

# Meta Conversions API: the server also reports each Purchase to Meta, so a
# customer who closes the tab before the confirmation page loads is still
# counted. Sent only for customers who accepted cookies, and deduplicated
# against the browser Pixel by a shared event id. Runtime values: restart,
# no rebuild. See lib/meta-capi.ts.
# Token: Events Manager → your pixel → Settings → Conversions API →
# Generate access token. Leave blank to send no server events.
META_CAPI_ACCESS_TOKEN=
# Optional. Sends events to Events Manager's "Test events" tab instead of live
# reporting. Set it to verify, then remove it.
META_CAPI_TEST_EVENT_CODE=
# Optional. Defaults to v26.0.
META_GRAPH_API_VERSION=

# GA4 is still build-time only. Set it, then REBUILD — restarting is not enough.
NEXT_PUBLIC_GA4_ID=

# ── Admin ─────────────────────────────────────────────────────────
# JWT_SECRET must be at least 32 characters: openssl rand -hex 32
JWT_SECRET=
# Plain text (hashed in memory at boot) or a pre-computed bcrypt hash ($2…).
ADMIN_PASSWORD=
# Used by `npx prisma db seed` to create the first admin login.
ADMIN_EMAIL=

# ── Email (OPTIONAL — Resend) ─────────────────────────────────────
# Leave RESEND_API_KEY blank to run without email: everything works, order
# emails are simply skipped. In development, bodies print to the console.
RESEND_API_KEY=
# MUST be an address on a domain verified in Resend. The example.com
# placeholder is refused deliberately — see lib/email.ts.
EMAIL_FROM="BacLab <noreply@baclab.co.uk>"
# Email the shop owner when a paid order lands. Blank disables it.
ORDER_NOTIFY_EMAIL=

# Trustpilot review invitations (Automatic Feedback Service). The unique
# address from Trustpilot Business → Get reviews → Invitation methods → BCC.
# Every order confirmation is BCC'd to it (except unsubscribed customers), and
# Trustpilot sends the invitation after the delay configured there. Set that
# delay to about 7 days so the parcel arrives first. While this is set, the
# cron's own review-request email stands down, so nobody is asked twice.
# Runtime: restart, no rebuild. Must end @invite.trustpilot.com.
TRUSTPILOT_BCC_EMAIL=

# ── Postage labels (SmartTrack) ───────────────────────────────────
# Carrier labels are bought from SmartTrack (docs.smarttrack.co). Leave the
# key blank and everything else works: SKUs, stock, pick lists, and the
# service each order needs are all worked out locally; only "Buy label" is
# unavailable. Runtime values: restart, no rebuild.
#
# UAT (qa.smarttrack.co) and live are SEPARATE accounts with separate keys.
# SMARTTRACK_ENV defaults to uat, so a key pasted in without it buys test
# labels, not real postage. Set it to live deliberately, with the live key.
SMARTTRACK_ENV=uat
# SmartTrack → log in → Profile → API Keys.
SMARTTRACK_API_KEY=
SMARTTRACK_API_SECRET=
# Label size, width x height in mm. 100x150 is the 4×6in thermal label, and
# the pick label is printed to match it.
SMARTTRACK_LABEL_SIZE=100x150

# ── Cron ──────────────────────────────────────────────────────────
# Bearer token protecting /api/cron/nudges (repurchase reminder job).
# Generate with: openssl rand -hex 32
# NOTE: repurchase reminders are marketing email and need consent. Leave
# this unset to keep the job disabled.
CRON_SECRET=

# ── Optional overrides ────────────────────────────────────────────
# Live FX rates, used only to derive the USD figure the crypto gateway
# settles in. Blank uses the free, keyless default.
FX_RATE_API_URL=
