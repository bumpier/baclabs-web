# Copy to .env.local and fill in real values. NEVER commit .env.local.
#
# Prisma's CLI reads .env (not .env.local), so DATABASE_URL needs to be in
# BOTH files. Everything else belongs in .env.local only.

# ── Database ──────────────────────────────────────────────────────
# Prisma resolves `file:` relative to prisma/, NOT the repo root, so this
# lands at <project-root>/data/baclab.db. Using file:./data/... silently
# creates prisma/data/ and the migration never reaches the real database.
DATABASE_URL="file:../data/baclab.db"

# Public site URL. Used for canonical tags, Open Graph, the sitemap, Stripe
# success/cancel redirects and transactional email links. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://baclab.co.uk

# ── Card payments (Stripe) ────────────────────────────────────────
# STRIPE_ENABLED is the kill switch and must equal the literal "true".
# Set it to false and restart to stop taking card payments instantly;
# crypto keeps working. Flip the flag — never delete the keys, or the
# webhook cannot verify already-captured payments and they sit unfulfilled.
STRIPE_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# One Stripe Price per bundle tier. Generate them with:
#   npx tsx scripts/stripe-setup.ts --apply
# which prints these five lines ready to paste. Run it once with a test key
# and once with a live key — the values differ between the two modes.
STRIPE_PRICE_SINGLE=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_VALUE=
STRIPE_PRICE_BULK=
STRIPE_PRICE_WHOLESALE=

# Optional. A Stripe shipping rate id (shr_…) added to every Checkout Session.
# Leave blank and Stripe charges nothing for delivery.
STRIPE_SHIPPING_RATE_ID=

# ── Crypto payments (secondary) ───────────────────────────────────
# Defaults to ON when unset. Set to "false" to hide the crypto option.
# CRYPTO_ENABLED=true
# CRYPTO_GATEWAY_URL — base URL of the self-hosted gateway.
# CRYPTO_WEBHOOK_SECRET — MUST exactly equal the gateway's WEBHOOK_SECRET.
CRYPTO_GATEWAY_URL=
CRYPTO_WEBHOOK_SECRET=

# ── Analytics (both optional) ─────────────────────────────────────
# WARNING: both are inlined at BUILD time. Setting one later and only
# restarting does nothing — you must rebuild.
# Leave blank and no tracking script loads at all.
# Note: enabling either almost certainly requires a cookie-consent banner in
# the UK. None is built.
# ── Sale preview ──────────────────────────────────────────────────
# Renders the sale UI (struck-through prices, "30% off" badge and banner)
# WITHOUT a qualifying reference period, for design review only. Inlined at
# BUILD time. Leave unset everywhere customers can reach — a struck-through
# price must be one the product was genuinely sold at. See SALE in
# config/funnel.ts.
NEXT_PUBLIC_SALE_PREVIEW=

NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GA4_ID=

# ── Admin ─────────────────────────────────────────────────────────
# JWT_SECRET must be at least 32 characters: openssl rand -hex 32
JWT_SECRET=
# Plain text (hashed in memory at boot) or a pre-computed bcrypt hash ($2…).
ADMIN_PASSWORD=
# Used by `npx prisma db seed` to create the first admin login.
ADMIN_EMAIL=

# ── Email (OPTIONAL — Resend) ─────────────────────────────────────
# Leave RESEND_API_KEY blank to run without email: everything works, order
# emails are simply skipped. In development, bodies print to the console.
RESEND_API_KEY=
# MUST be an address on a domain verified in Resend. The example.com
# placeholder is refused deliberately — see lib/email.ts.
EMAIL_FROM="BacLab <noreply@baclab.co.uk>"
# Email the shop owner when a paid order lands. Blank disables it.
ORDER_NOTIFY_EMAIL=

# ── Cron ──────────────────────────────────────────────────────────
# Bearer token protecting /api/cron/nudges (repurchase reminder job).
# Generate with: openssl rand -hex 32
# NOTE: repurchase reminders are marketing email and need consent. Leave
# this unset to keep the job disabled.
CRON_SECRET=

# ── Optional overrides ────────────────────────────────────────────
# Live FX rates, used only to derive the USD figure the crypto gateway
# settles in. Blank uses the free, keyless default.
FX_RATE_API_URL=
